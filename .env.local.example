NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional — sem ela, a busca de capa por título/ISBN usa a quota anônima
# compartilhada do Google Books, que satura fácil (HTTP 429). Gerar em
# console.cloud.google.com > APIs & Services > habilitar "Books API" >
# Create credentials > API key. Gratuita, ~1000 req/dia próprias.
GOOGLE_BOOKS_API_KEY=

# Opcional, só servidor — NUNCA com o prefixo NEXT_PUBLIC_. Necessária apenas para mostrar, em links
# compartilhados e na página de amigos, as capas que você enviou como foto (ficam no bucket privado).
# Sem ela essas capas aparecem como "sem capa" para quem visita; as capas vindas de busca automática
# (catálogo público) funcionam sem a chave. Supabase > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
